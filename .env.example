# Copy to .env (or export in your shell / cron environment). Never commit real keys.

# Language model: anthropic (default) | openai | mock
DBM_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
# DBM_ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallback on Anthropic requests (1 = on, 0 = off)
# DBM_ANTHROPIC_FALLBACKS=1

# OPENAI_API_KEY=your-openai-key-here
# DBM_OPENAI_MODEL=gpt-4.1

# Search: auto (Tavily if its key is set, else Brave) | tavily | brave | mock
DBM_SEARCH_PROVIDER=auto
TAVILY_API_KEY=your-tavily-key-here
# BRAVE_API_KEY=your-brave-key-here

# Optional: alternate fixture file for the mock search provider
# DBM_MOCK_FIXTURES=path/to/fixtures.json
